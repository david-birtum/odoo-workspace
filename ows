#!/usr/bin/env python3

import sys
import traceback
from pathlib import Path

from commands import status, current, sync, switch

#
# Directorio raíz:
# /home/dd/git_repos
#
GIT_ROOT = Path(__file__).resolve().parent.parent


def usage():
    print(
        """
OWS - Odoo Workspace Manager

Usage:
    ows status  <version> <workspace>
    ows current <version>
    ows switch  <version> <workspace>
    ows sync    <version> <workspace>

Commands:
    status      Compare current branches with a workspace manifest.
    current     Show a ranking of workspaces based on current branches.
    switch      Checkout the expected branch on each repo (never
                touches a dirty or unpushed repo; does not pull).
    sync        Auto-update (git pull --ff-only) repos that are on the
                expected branch, clean, and with nothing to push.

Examples:
    ows status 19 BESTWAY
    ows status 19 PRISSA
    ows current 19
    ows switch 19 BESTWAY
    ows sync 19 BESTWAY
"""
    )
    sys.exit(1)


def cmd_status():

    if len(sys.argv) != 4:
        usage()

    status(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def cmd_current():

    if len(sys.argv) != 3:
        usage()

    current(
        GIT_ROOT,
        sys.argv[2],
    )


def cmd_sync():

    if len(sys.argv) != 4:
        usage()

    sync(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def cmd_switch():

    if len(sys.argv) != 4:
        usage()

    switch(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def main():

    if len(sys.argv) < 2:
        usage()

    command = sys.argv[1]

    if command == "status":
        cmd_status()

    elif command == "current":
        cmd_current()

    elif command == "sync":
        cmd_sync()

    elif command == "switch":
        cmd_switch()

    else:
        usage()

if __name__ == "__main__":
    try:
        main()
    except Exception:
        traceback.print_exc()
        sys.exit(1)

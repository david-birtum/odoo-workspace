#!/usr/bin/env python3

import os
import sys
import traceback
from pathlib import Path

from commands import status, current, sync, switch

#
# Directorio raíz:
# /home/dd/git_repos
#
GIT_ROOT = Path(__file__).resolve().parent.parent


def usage():
    print(
        """
OWS - Odoo Workspace Manager

Usage:
    ows status  <version> <workspace>
    ows current <version>
    ows switch  <version> <workspace>
    ows sync    <version> <workspace>
    ows ui      [port]

Commands:
    status      Compare current branches with a workspace manifest.
    current     Show a ranking of workspaces based on current branches.
    switch      Checkout the expected branch on each repo (never
                touches a dirty or unpushed repo; does not pull).
    sync        Auto-update (git pull --ff-only) repos that are on the
                expected branch, clean, and with nothing to push.
    ui          Local web UI (read-only status) on 127.0.0.1:8765.

Examples:
    ows status 19 BESTWAY
    ows status 19 PRISSA
    ows current 19
    ows switch 19 BESTWAY
    ows sync 19 BESTWAY
    ows ui
    ows ui 8766
"""
    )
    sys.exit(1)


def cmd_status():

    if len(sys.argv) != 4:
        usage()

    status(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def cmd_current():

    if len(sys.argv) != 3:
        usage()

    current(
        GIT_ROOT,
        sys.argv[2],
    )


def cmd_sync():

    if len(sys.argv) != 4:
        usage()

    sync(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def cmd_switch():

    if len(sys.argv) != 4:
        usage()

    switch(
        GIT_ROOT,
        sys.argv[2],
        sys.argv[3],
    )


def cmd_ui():

    port = 8765

    if len(sys.argv) == 3:
        try:
            port = int(sys.argv[2])
        except ValueError:
            usage()
    elif len(sys.argv) != 2:
        usage()

    here = Path(__file__).resolve().parent
    venv_python = here / ".venv" / "bin" / "python"
    in_venv = Path(sys.prefix).resolve() == (here / ".venv").resolve()

    if venv_python.exists() and not in_venv:
        os.execv(
            str(venv_python),
            [str(venv_python), str(here / "ows"), *sys.argv[1:]],
        )

    try:
        from ui import start_ui
    except ImportError:
        print(
            "ows ui requires nicegui. "
            "From this repo: python3 -m venv .venv && "
            ".venv/bin/pip install -r requirements.txt"
        )
        sys.exit(1)

    start_ui(GIT_ROOT, port=port)


def main():

    if len(sys.argv) < 2:
        usage()

    command = sys.argv[1]

    if command == "status":
        cmd_status()

    elif command == "current":
        cmd_current()

    elif command == "sync":
        cmd_sync()

    elif command == "switch":
        cmd_switch()

    elif command == "ui":
        cmd_ui()

    else:
        usage()

if __name__ == "__main__":
    try:
        main()
    except Exception:
        traceback.print_exc()
        sys.exit(1)
